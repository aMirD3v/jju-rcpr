# PostgreSQL — required for all persistent workflow data.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/jju_rcpr_db?schema=public"

# Authentication — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# One-time setup for the first system administrator. Run npm run provision:admin,
# then remove the password from the environment. Never commit the real values.
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_INSTITUTION="Jigjiga University"
INITIAL_ADMIN_PASSWORD=""

# Email is optional. Notifications remain in-app if these are unset.
RESEND_API_KEY=""
EMAIL_FROM="JJU-RCPR <noreply@jju.edu.et>"

# Document storage
# Production: Cloudflare R2. When R2_ACCESS_KEY_ID is present, use R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="jju-rcpr-documents"

# Local development: MinIO. Used when R2_ACCESS_KEY_ID is not configured.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="jju-rcpr-documents"
