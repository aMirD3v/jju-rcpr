generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COORDINATOR
  REVIEWER
  RESEARCHER
}

enum CallStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  SUBMITTED
  RETURNED_FOR_CORRECTION
  SCREENING_DECLINED
  ELIGIBLE_FOR_REVIEW
  UNDER_REVIEW
  REVISION_REQUESTED
  ACCEPTED
  REJECTED
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  CONFLICT_DECLARED
  COMPLETED
  REASSIGNED
}

enum Recommendation {
  ACCEPT
  MINOR_REVISION
  MAJOR_REVISION
  REJECT
}

enum NotificationType {
  INFO
  ACTION_REQUIRED
  DECISION
}

model User {
  id                       String               @id @default(cuid())
  email                    String               @unique
  name                     String
  role                     Role
  passwordHash             String?
  passwordResetRequired    Boolean              @default(false)
  passwordResetTokenHash   String?              @unique
  passwordResetTokenExpiry DateTime?
  sessionVersion           Int                  @default(0)
  isActive                 Boolean              @default(true)
  emailVerifiedAt          DateTime?
  verificationTokenHash    String?              @unique
  verificationTokenExpiry  DateTime?
  failedLoginAttempts      Int                  @default(0)
  lockoutUntil             DateTime?
  institution              String?
  reviewerAssignments      ReviewerAssignment[] @relation("ReviewerAssignments")
  coordinatedCalls         ResearchCall[]       @relation("CallCoordinator")
  submissions              ResearchSubmission[] @relation("ResearcherSubmissions")
  decisions                ResearchDecision[]   @relation("DecisionMaker")
  notifications            Notification[]
  events                   WorkflowEvent[]
  auditLogs                AuditLog[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([role])
  @@index([role, isActive])
}

model ResearchCall {
  id                String               @id @default(cuid())
  title             String
  description       String
  topics            String[]
  requirements      String
  acceptedFileTypes String[]
  opensAt           DateTime
  closesAt          DateTime
  status            CallStatus           @default(DRAFT)
  coordinatorId     String
  coordinator       User                 @relation("CallCoordinator", fields: [coordinatorId], references: [id])
  criteria          ReviewCriterion[]
  submissions       ResearchSubmission[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, opensAt, closesAt])
}

model ReviewCriterion {
  id          String       @id @default(cuid())
  label       String
  description String?
  position    Int
  callId      String
  call        ResearchCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, position])
}

model ResearchSubmission {
  id              String               @id @default(cuid())
  referenceNumber String               @unique
  callId          String
  call            ResearchCall         @relation(fields: [callId], references: [id])
  researcherId    String
  researcher      User                 @relation("ResearcherSubmissions", fields: [researcherId], references: [id])
  title           String
  abstract        String
  topic           String
  institution     String
  status          SubmissionStatus     @default(SUBMITTED)
  currentRound    Int                  @default(1)
  versions        SubmissionVersion[]
  authors         SubmissionAuthor[]
  assignments     ReviewerAssignment[]
  decisions       ResearchDecision[]
  events          WorkflowEvent[]
  documents       SubmissionDocument[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([callId, status])
  @@index([researcherId, updatedAt])
}

model SubmissionAuthor {
  id              String             @id @default(cuid())
  submissionId    String
  submission      ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fullName        String
  email           String
  institution     String
  isCorresponding Boolean            @default(false)
  position        Int

  @@unique([submissionId, position])
  @@index([submissionId])
}

model SubmissionVersion {
  id           String               @id @default(cuid())
  submissionId String
  submission   ResearchSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  round        Int
  title        String
  abstract     String
  submittedAt  DateTime             @default(now())
  documents    SubmissionDocument[]

  @@unique([submissionId, round])
}

model SubmissionDocument {
  id           String             @id @default(cuid())
  submissionId String
  submission   ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  versionId    String?
  version      SubmissionVersion? @relation(fields: [versionId], references: [id])
  originalName String
  objectKey    String             @unique
  mimeType     String
  byteSize     Int
  checksum     String
  createdAt    DateTime           @default(now())

  @@index([submissionId])
}

model ReviewerAssignment {
  id           String             @id @default(cuid())
  submissionId String
  submission   ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User               @relation("ReviewerAssignments", fields: [reviewerId], references: [id])
  assignedById String
  dueAt        DateTime
  status       AssignmentStatus   @default(PENDING)
  acceptedAt   DateTime?
  conflictNote String?
  supersededAt DateTime?
  review       PeerReview?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([reviewerId, status, dueAt])
  @@index([submissionId, status])
}

model PeerReview {
  id                   String             @id @default(cuid())
  assignmentId         String             @unique
  assignment           ReviewerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  originality          Int
  relevance            Int
  researchQuality      Int
  methodology          Int
  clarity              Int
  authorComments       String
  confidentialComments String?
  recommendation       Recommendation
  submittedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model ResearchDecision {
  id              String             @id @default(cuid())
  submissionId    String
  submission      ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  decisionMakerId String
  decisionMaker   User               @relation("DecisionMaker", fields: [decisionMakerId], references: [id])
  status          SubmissionStatus
  feedback        String
  isOverride      Boolean            @default(false)
  overrideReason  String?
  createdAt       DateTime           @default(now())

  @@index([submissionId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

model WorkflowEvent {
  id           String             @id @default(cuid())
  submissionId String
  submission   ResearchSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User               @relation(fields: [actorId], references: [id])
  eventType    String
  fromStatus   SubmissionStatus?
  toStatus     SubmissionStatus?
  detail       Json?
  createdAt    DateTime           @default(now())

  @@index([submissionId, createdAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id])
  action       String
  resourceType String
  resourceId   String
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorId, createdAt])
}
